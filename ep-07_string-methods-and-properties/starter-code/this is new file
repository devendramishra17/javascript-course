// tell if the number is palindrom

function isPalindrom(n) {
    if (n < 0) {
        return "not a palindrom";
    }
    let reverse = 0;
    let num_copy = n;
    while (n > 0) {
        let lastDigit = n % 10;
        reverse = reverse * 10 + lastDigit;
        n = Math.floor(n/ 10); 
    }
    if (reverse == num_copy) {
        return true;
    }
    else return false;
}

console.log(isPalindrom(1331));
